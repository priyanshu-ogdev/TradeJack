# Copy this file to .env.local (Vite auto-loads .env.local, and it's
# gitignored by Vite's default template -- never commit real values).

# Base URL of the control_panel_api.py FastAPI backend.
VITE_API_BASE=http://localhost:8000

# Must match the TRADEJACK_API_TOKEN the backend was started with.
# This token is visible in the built frontend bundle -- treat it as a
# shared secret between you and your own browser, not a public credential.
# Do not deploy this frontend anywhere public without putting real auth
# (a login step, not just a bearer token baked into the JS bundle) in front
# of it first.
VITE_API_TOKEN=change-me
