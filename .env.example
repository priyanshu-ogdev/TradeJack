# TradeJack Exchange Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# Binance Spot API credentials
# Get testnet keys/keypairs at: https://testnet.binance.vision/
BINANCE_API_KEY=your_testnet_api_key_here

# --- Preferred: Ed25519 key (Binance's own current recommendation) ---
# Binance's docs: "HMAC keys are deprecated. We recommend to migrate to
# asymmetric API keys, such as Ed25519" -- smaller and faster to verify than
# RSA, and unlike HMAC no shared secret is ever transmitted. Generate a
# keypair with Binance's own Asymmetric Keys Generator tool, register the
# PUBLIC key on Binance, and point this at the PRIVATE key's PEM file path
# (never the key content itself, and never commit the file):
BINANCE_ED25519_PRIVATE_KEY_PATH=

# --- Legacy fallback: HMAC secret (still functional, but deprecated by ---
# --- Binance -- only used if the Ed25519 path above is empty) ---
BINANCE_API_SECRET=your_testnet_api_secret_here

# Exchange mode: paper | testnet | live
# Start with paper, graduate to testnet, then live only after evidence.
EXCHANGE_MODE=paper

# Qdrant Vector DB (optional, for lineage tracking)
QDRANT_URL=http://localhost:6333

# HuggingFace (optional, for model hub)
HF_TOKEN=
