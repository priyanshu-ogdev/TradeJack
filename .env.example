# TradeJack Exchange Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# Binance Spot API (testnet keys for development)
# Get testnet keys at: https://testnet.binance.vision/
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# Exchange mode: paper | testnet | live
# Start with paper, graduate to testnet, then live only after evidence.
EXCHANGE_MODE=paper

# Qdrant Vector DB (optional, for lineage tracking)
QDRANT_URL=http://localhost:6333

# HuggingFace (optional, for model hub)
HF_TOKEN=
